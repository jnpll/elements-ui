{
  "name": "@jnpll/elements-ui",
  "version": "0.3.0",
  "description": "Shared Elements shadcn components and Tailwind CSS 4 theme",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jnpll/elements-ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "LICENSES",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./icons/*.svg": "./dist/icons/*.svg",
    "./collections/alpha/theme.json": "./dist/collections/alpha/theme.json",
    "./collections/britanniae/theme.json": "./dist/collections/britanniae/theme.json",
    "./collections/britanniae/theme.css": "./dist/collections/britanniae/theme.css",
    "./collections/britanniae/palettes/*.css": "./dist/collections/britanniae/palettes/*.css",
    "./collections/alpha/theme.css": "./dist/collections/alpha/theme.css",
    "./collections/alpha/palettes/neutral.css": "./dist/collections/alpha/palettes/neutral.css",
    "./utils": {
      "types": "./dist/lib/utils.d.ts",
      "import": "./dist/lib/utils.js"
    },
    "./*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-styles.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/verify-exports.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^4.14.2",
    "recharts": "^3.8.0",
    "shadcn": "^4.19.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "lucide-react": "^1.39.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
