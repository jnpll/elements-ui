{
  "schemaVersion": 1,
  "id": "cosmo",
  "name": "Cosmo",
  "defaultPalette": "astral",
  "design": {
    "baseRadius": "1rem",
    "spacingUnit": "0.25rem",
    "typography": {
      "heading": "Space Grotesk, Avenir Next, Arial, sans-serif",
      "sans": "Space Grotesk, Avenir Next, Arial, sans-serif",
      "mono": "JetBrains Mono, SFMono-Regular, Consolas, monospace"
    },
    "states": [
      "default",
      "hover",
      "focus-visible",
      "active",
      "disabled",
      "invalid"
    ],
    "primitives": "Semantic HTML and Base UI; geometric headings, mono labels, rounded controls, translucent panels, and an optional full-viewport WebGL backdrop using the jnpl shader."
  },
  "palettes": [
    {
      "id": "astral",
