{
  "schemaVersion": 1,
  "id": "pantheon",
  "name": "Pantheon",
  "defaultPalette": "apollo",
  "design": {
    "baseRadius": "0.375rem",
    "spacingUnit": "0.25rem",
    "typography": {
      "heading": "Georgia, \"Times New Roman\", serif",
      "sans": "Arial, Helvetica, sans-serif",
      "mono": "ui-monospace, monospace"
    },
    "states": [
      "default",
      "hover",
      "focus-visible",
      "active",
      "disabled",
      "invalid"
    ],
    "primitives": "Semantic HTML and Base UI; monumental headings, stone-like surfaces, and defined borders."
  },
  "palettes": [
